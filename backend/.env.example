PORT=5000
#MONGODB_URI=mongodb://127.0.0.1:27017/payroll_system
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/payroll_system?retryWrites=true&w=majority

JWT_ACCESS_SECRET=change_me_to_a_long_random_string
JWT_REFRESH_SECRET=change_me_to_another_long_random_string
JWT_ACCESS_EXPIRES=8h
JWT_REFRESH_EXPIRES=7d

# Local Vite: http://localhost:5173
# Railway (same service serving SPA): https://YOUR-APP.up.railway.app
CLIENT_URL=http://localhost:5173

NODE_ENV=development

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@alphagroup.local
UPLOAD_DIR=uploads
